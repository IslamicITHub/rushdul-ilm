# ============================================================
# Rushd-ul-Ilm Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual .env file to git!
# ============================================================

# ── NVIDIA NIM API Key ──────────────────────────────────────
# Optional cloud LLM: the backend selects NVIDIA NIM (openai/gpt-oss-20b)
# whenever this key is configured. Questions and retrieved context are sent to NIM.
# Get your free key from: https://build.nvidia.com/
# Leave empty to select local Ollama (qwen3:4b); only add a valid key to enable NIM.
# A failed NIM request does not automatically retry with Ollama.
NVIDIA_API_KEY=

# ── Hugging Face Token ──────────────────────────────────────
# Used for downloading gated models (IndicTrans2, Indic Parler TTS)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

